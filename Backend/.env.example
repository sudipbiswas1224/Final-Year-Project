# Production environment variables for deployment
# Replace these values with your actual production values

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas (Replace with your Atlas connection string)
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/mental-health-chatbot?retryWrites=true&w=majority

# JWT Secret (Use a strong, unique secret for production)
JWT_SECRET=your-super-secure-jwt-secret-here

# Email Settings (Nodemailer SMTP)
EMAIL_HOST=your-smtp-host
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_SECURE=false
EMAIL_FROM="Psykin Companion" <your-email@example.com>


